{
  "name": "transport-game",
  "version": "0.0.0",
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^26.2.0",
    "@types/three": "^0.186.0",
    "playwright-core": "^1.62.1",
    "three": "^0.186.1",
    "typescript": "^5.7",
    "vite": "^8.2.1"
  },
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:parallel": "bun scripts/test-parallel.ts",
    "preview": "vite preview",
    "verify:bundle": "node scripts/verify-prod-bundle.mjs",
    "verify:look": "bun scripts/verify-look.ts",
    "verify": "bun run typecheck && bun run test:parallel && bun run build && bun run verify:bundle && bun run verify:look",
    "shots": "bun scripts/shots.ts",
    "gym": "bun gym/run.ts",
    "run-file": "bun build scripts/game-run.ts --target=node --outfile=.cache/game-run.mjs --log-level=error && node .cache/game-run.mjs"
  },
  "type": "module"
}
